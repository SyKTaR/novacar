# Clé publique Web3Forms (https://web3forms.com) pour le formulaire de
# contact. Remplacer par la vraie clé fournie par Lucas dans un fichier
# .env (ou .env.local) NON commité. Ne jamais committer de vraie clé ici.
VITE_WEB3FORMS_KEY=your-web3forms-access-key

# Identifiant de mesure Google Analytics 4 (format G-XXXXXXXXXX), créé dans
# GA4 par Lucas. Tant que cette variable est vide, aucun script GA4 n'est
# chargé (voir src/lib/analytics.ts) — même en production. Une fois
# renseigné, GA4 ne se charge encore qu'après acceptation du bandeau de
# consentement cookies (voir src/components/CookieConsent.tsx).
VITE_GA4_MEASUREMENT_ID=
